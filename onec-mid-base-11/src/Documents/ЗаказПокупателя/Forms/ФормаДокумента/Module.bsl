// ++ Боброва _______ 08.11.2026
&НаКлиенте
Процедура РассчитатьСуммуСтроки(ТекущиеДанные)
	
	//КоэффициентСкидки = 1 - ТекущиеДанные.Скидка / 100;
	//ТекущиеДанные.Сумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество * КоэффициентСкидки;
	
	СуммаСкидок = (Объект.ДЗ_СогласованнаяСкидка + ТекущиеДанные.Скидка)/100;
	Если СуммаСкидок <= 1 Тогда
		ТекущиеДанные.Сумма = (ТекущиеДанные.Цена*ТекущиеДанные.Количество) - (ТекущиеДанные.Цена*ТекущиеДанные.Количество)* СуммаСкидок;
	Иначе
		Сообщить("Скидка не может быть больше 100%");
		ТекущиеДанные.Сумма = 0; 
	КонецЕсли;
	
	РассчитатьСуммуДокумента();
КонецПроцедуры  


&НаКлиенте 
Процедура ПересчитатьТаблицы()
	
	Для Каждого Элемент Из Объект.Товары Цикл 
		РассчитатьСуммуСтроки(Элемент);
		
	КонецЦикла;
	Для Каждого Элемент Из Объект.Услуги Цикл 
		РассчитатьСуммуСтроки(Элемент);
	КонецЦикла;
	РассчитатьСуммуДокумента(); 
	
КонецПроцедуры   


&НаСервере
Процедура ДобавитьПрограммноКомандуНаСервере() 
	
	
	Если НЕ Элементы.Найти("ГруппаСкидки") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОсновнаяГруппа = Элементы.ГруппаШапкаЛево;
	
	НоваяГруппа = Элементы.Добавить("ГруппаСкидки", Тип ("ГруппаФормы"), ОсновнаяГруппа);
	НоваяГруппа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	НоваяГруппа.Отображение = ОтображениеОбычнойГруппы.Нет;
	НоваяГруппа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	НоваяГруппа.Заголовок = "";
	НоваяГруппа.ОтображатьЗаголовок = Ложь;
	
	ПолеСкидки = Элементы.Добавить("ДЗ_СогласованнаяСкидка", Тип("ПолеФормы"), НоваяГруппа);
	ПолеСкидки.ПутьКДанным = "Объект.ДЗ_СогласованнаяСкидка";
	ПолеСкидки.Вид = ВидПоляФормы.ПолеВвода;
	ПолеСкидки.Заголовок = "Согласованная скидка, %";
	ПолеСкидки.РастягиватьПоГоризонтали = Истина; 
	ПолеСкидки.УстановитьДействие("ПриИзменении", "СогласованнаяСкидкаПриИзмененииПосле");
	
	//Добавим команду в коллекцию команд
	КомандаСогласованнаяСкидка = Команды.Добавить("ПересчитатьСкидку");
	КомандаСогласованнаяСкидка.Заголовок = "Пересчитать скидку";
	КомандаСогласованнаяСкидка.Действие = "ПересчитатьСкидкуПосле";
	
	КнопкаКоманды = Элементы.Добавить("КнопкаСогласованнаяСкидка", Тип("КнопкаФормы"), НоваяГруппа);
	КнопкаКоманды.ИмяКоманды = "ПересчитатьСкидку";
	КнопкаКоманды.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
	
	
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСкидкуПосле(Команда)
	
	ПересчитатьТаблицы();
КонецПроцедуры

&НаКлиенте
Асинх Процедура СогласованнаяСкидкаПриИзмененииПосле(Элемент)
	Если ЗначениеЗаполнено(Объект.Товары) ИЛИ ЗначениеЗаполнено(Объект.Услуги) Тогда 
		
		Вопрос = ВопросАсинх("Изменен процент скидки. Пересчитать таблицу товаров и услуг?", РежимДиалогаВопрос.ДаНет);
		ОтветНаВопрос = Ждать Вопрос;
		Если ОтветНаВопрос = КодВозвратаДиалога.Да Тогда
			ПересчитатьТаблицы();
		КонецЕсли;
		
	КонецЕсли; 
Конецпроцедуры



